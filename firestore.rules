rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    // Strict server-side validation against authorized admin email list
    function isAdmin() {
      return (isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() in ['ancor.primee@gmail.com']);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /user_profiles/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) &&
        incoming().displayName is string && incoming().displayName.size() <= 100;
      allow delete: if isAdmin();
    }

    // Threads
    match /threads/{threadId} {
      allow read: if true;
      allow create: if isValidId(threadId) &&
        incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 200 &&
        incoming().content is string && incoming().content.size() >= 2 && incoming().content.size() <= 100000;
      allow update: if isValidId(threadId);
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    // Replies
    match /replies/{replyId} {
      allow read: if true;
      allow create: if isValidId(replyId) &&
        incoming().content is string && incoming().content.size() >= 1 && incoming().content.size() <= 100000;
      allow update: if isValidId(replyId);
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    // Likes / Mis dies
    match /likes/{likeId} {
      allow read: if true;
      allow create, delete: if isValidId(likeId);
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
